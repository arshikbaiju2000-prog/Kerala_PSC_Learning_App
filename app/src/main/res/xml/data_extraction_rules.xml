<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include only preference configuration data, strictly excluding SQLite databases and caches -->
        <include domain="sharedpref" path="psc_target_preferences.preferences_pb" />
        <include domain="sharedpref" path="psc_app_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="psc_target_preferences.preferences_pb" />
        <include domain="sharedpref" path="psc_app_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
